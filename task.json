{
  "atomCode": "dependency-check-report",
  "name": "Dependency vulnerabilities",
  "version": "1.0.0",
  "description": "Reads an OWASP dependency-check XML report and gates on critical/high findings.",
  "execution": {
    "packagePath": "dependency-check-report.jar",
    "language": "java",
    "target": "$atom_java_path -cp dependency-check-report.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "pattern": {
      "label": "报告 glob",
      "type": "vuex-input",
      "default": "**/dependency-check-report.xml"
    },
    "label": {
      "label": "报告名称",
      "type": "vuex-input",
      "default": "Dependencies"
    },
    "outputDir": {
      "label": "HTML 输出目录",
      "type": "vuex-input",
      "default": "out/dependencies"
    },
    "maxCritical": {
      "label": "允许的 critical 数",
      "type": "vuex-input-number",
      "default": "0"
    },
    "maxHigh": {
      "label": "允许的 high 数（-1 = 不检查）",
      "type": "vuex-input-number",
      "default": "-1"
    },
    "maxTotal": {
      "label": "允许的漏洞总数（-1 = 不检查）",
      "type": "vuex-input-number",
      "default": "-1"
    }
  },
  "output": {
    "dependencies": {
      "type": "string",
      "description": "依赖数"
    },
    "vulnerabilities": {
      "type": "string",
      "description": "漏洞数"
    },
    "critical": {
      "type": "string",
      "description": "critical 数"
    },
    "high": {
      "type": "string",
      "description": "high 数"
    },
    "medium": {
      "type": "string",
      "description": "medium 数"
    },
    "report": {
      "type": "report",
      "description": "构建页内嵌报告"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    }
  }
}
